# Bu dosyayi .env.local olarak kopyalayin ve degerleri doldurun.
# .env.example git'e girer, .env.local GIRMEZ.

# Groq API anahtari -> https://console.groq.com/keys
GROQ_API_KEY=

# Model secimi (opsiyonel)
GROQ_MODEL_SMART=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MODEL_FALLBACK=llama-3.3-70b-versatile

# Motor anahtarlari (0 = kapali)
ENGINE_DOMAIN_AI=1
ENGINE_DOMAIN_AVAILABILITY=1

GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
GOOGLE_PLACE_CID=10560064220033697496
GOOGLE_PUAN=4.9
GOOGLE_YORUM_ADEDI=69
ENGINE_GOOGLE_REVIEWS=1

# Cron ucu icin gizli anahtar (sunucudaki crontab ile ayni deger)
CRON_TOKEN=

# Isletme adi (GOOGLE_PLACE_ID bos ise bu adla aranir)
GOOGLE_PLACE_ADI=SunucumWEB

# Araclar motoru (0 = kapali)
ENGINE_TOOLS=1
