{
  "name": "sunucumweb-next",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n css,next -c cyan,green \"npm:dev:css\" \"npm:dev:next\"",
    "dev:css": "tailwindcss -i ./app/globals.css -o ./public/tailwind.css --watch",
    "dev:next": "next dev --turbopack -p 3000",
    "build:css": "tailwindcss -i ./app/globals.css -o ./public/tailwind.css --minify",
    "build": "npm run build:css && next build",
    "start": "next start -p 3000",
    "lint": "next lint"
  },
  "browserslist": [
    "> 0.2%",
    "last 4 versions",
    "Firefox ESR",
    "Safari >= 15",
    "iOS >= 15",
    "Chrome >= 100",
    "Edge >= 100",
    "Firefox >= 100",
    "Android >= 9",
    "Samsung >= 18",
    "Opera >= 80",
    "not dead",
    "not op_mini all"
  ],
  "dependencies": {
    "html-react-parser": "^5.2.2",
    "lenis": "^1.3.26",
    "next": "15.1.6",
    "nodemailer": "^9.0.5",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "server-only": "^0.0.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "postcss": "^8.4.49",
    "postcss-safe-parser": "^7.0.1",
    "tailwindcss": "^3.4.17"
  }
}
